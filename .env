# ---------------------------------------------------------------------------
# Copy this file to ".env" and adjust the values for your machine.
# Never commit the real .env file - it is listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
# Generate a strong key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=956a93b70f92c5c20b86c1007e41aa0195bed7ca46217cf3e79c0ae0334909a0

# development | testing | production
FLASK_CONFIG=development
FLASK_DEBUG=1

# Host and port used by "python run.py"
HOST=127.0.0.1
PORT=5000

# --- Database --------------------------------------------------------------
# SQLite is used by default. To switch to PostgreSQL install psycopg2 and use:
#   DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/msl_recognition
# To switch to MySQL install PyMySQL and use:
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/msl_recognition
DATABASE_URL=sqlite:///instance/msl.db

# --- Sessions and uploads --------------------------------------------------
SESSION_LIFETIME_SECONDS=28800
SESSION_COOKIE_SECURE=0
MAX_CONTENT_LENGTH=12582912

# --- Computer vision -------------------------------------------------------
# Expected location of the official MediaPipe hand landmarker task asset.
# Download it from:
# https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task
MEDIAPIPE_MODEL_PATH=assets/models/hand_landmarker.task

MAX_HANDS=2
HAND_DETECTION_CONFIDENCE=0.5
HAND_PRESENCE_CONFIDENCE=0.5
HAND_TRACKING_CONFIDENCE=0.5

# --- Machine learning ------------------------------------------------------
# Fallback confidence threshold used when a model does not define its own.
RECOGNITION_CONFIDENCE_THRESHOLD=0.60

# Participant split ratios (the remainder is used for the held-out test set).
TRAIN_PARTICIPANT_RATIO=0.70
VALIDATION_PARTICIPANT_RATIO=0.15
RANDOM_STATE=42

# --- Misc ------------------------------------------------------------------
ITEMS_PER_PAGE=15
AUTO_MIGRATE_ON_START=1
